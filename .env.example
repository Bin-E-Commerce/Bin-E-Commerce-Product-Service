# ============================================================
# Product Service Environment
# ============================================================
# Scope:
# - Copy to services/product-service/.env for local standalone runs.
# - In production, inject only product-service variables through
#   Secret Manager, Kubernetes Secret, ECS Task Definition, or CI/CD secrets.
# ============================================================

NODE_ENV=development
PORT=3008
APP_VERSION=1.0.0
TYPEORM_LOGGING=false

# PostgreSQL - product database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=bin_ecommerce_product

# Internal service authentication - must match Order/Cart/Auth in local Docker runs.
INTERNAL_SERVICE_TOKEN=dev-media-auth-internal-secret

# Internal service discovery - use localhost for standalone local development.
SELLER_SERVICE_URL=http://localhost:3007
CATALOG_SERVICE_URL=http://localhost:3003
MEDIA_SERVICE_URL=http://localhost:3004
