# ============================================================
# Biến môi trường của Product Service
# ============================================================
# Phạm vi sử dụng:
# - Sao chép file này thành services/product-service/.env khi chạy local.
# - Khi chạy Docker Compose, dùng hostname service trong docker-compose.yml.
# - Production phải inject password và token qua Secret Manager/Kubernetes Secret.
# ============================================================

# -----------------------------------------------------------------------------
# 01. Runtime - HTTP API và log TypeORM
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3008
APP_VERSION=1.0.0
TYPEORM_LOGGING=false

# -----------------------------------------------------------------------------
# 02. PostgreSQL - cơ sở dữ liệu riêng của Product Service
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=
POSTGRES_DB=bin_ecommerce_product

# -----------------------------------------------------------------------------
# 03. Service đồng bộ - xác thực, shop, danh mục, media và order
# -----------------------------------------------------------------------------
# Khi chạy local, các service dùng port public/standalone tương ứng.
INTERNAL_SERVICE_TOKEN=
ORDER_SERVICE_URL=http://localhost:3011
AUTH_SERVICE_URL=http://localhost:3002
SELLER_SERVICE_URL=http://localhost:3007
CATALOG_SERVICE_URL=http://localhost:3003
MEDIA_SERVICE_URL=http://localhost:3004

# -----------------------------------------------------------------------------
# 04. Kafka - publish catalog/product event
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=product-service
